<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The road to PaLLi is Tailscale, which WireGuard already encrypts; the
         backend speaks plain http on it. An https:// address works too. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
